// Python ile Hizli Kodlama - Codespaces ortam ayari
// Codespace acildiginda Python 3.14 ve VS Code Python eklentisi hazir gelir.
{
  "name": "Python ile Hizli Kodlama",

  // Microsoft'un resmi Python 3.14 imaji (python, pip ve git kurulu gelir)
  "image": "mcr.microsoft.com/devcontainers/python:2-3.14",

  // 2 cekirdekli makine: egitim icin yeterli, ucretsiz kotayi en az harcayan secenek
  "hostRequirements": {
    "cpus": 2
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",

        // Run dugmesi dosyayi kendi klasorunde calistirsin;
        // boylece "satislar.csv" gibi goreli dosya yollari her ornekte calisir
        "python.terminal.executeInFileDir": true,

        // Kaydetmeyi unutan olmasin
        "files.autoSave": "afterDelay",

        // Alistirmalarda yapay zeka otomatik tamamlamasi cevabi vermesin
        // (Yapay zeka bolumunde bu ayar birlikte acilacak)
        "editor.inlineSuggest.enabled": false,

        "editor.fontSize": 15,
        "terminal.integrated.fontSize": 14,
        "workbench.startupEditor": "readme"
      }
    }
  }
}
