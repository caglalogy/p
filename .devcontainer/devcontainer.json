// Python ile Hızlı Kodlama — Codespaces ortam ayarı
// Codespace açıldığında Python 3.14 ve VS Code Python eklentisi hazır gelir.
{
  "name": "Python ile Hızlı Kodlama",

  // Microsoft'un resmi Python 3.14 imajı (python, pip ve git kurulu gelir)
  "image": "mcr.microsoft.com/devcontainers/python:2-3.14",

  // 2 çekirdekli makine: eğitim için yeterli, ücretsiz kotayı en az harcayan seçenek
  "hostRequirements": {
    "cpus": 2
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",

        // Run düğmesi dosyayı kendi klasöründe çalıştırsın;
        // böylece "satislar.csv" gibi göreli dosya yolları her örnekte çalışır
        "python.terminal.executeInFileDir": true,

        // Kaydetmeyi unutan olmasın
        "files.autoSave": "afterDelay",

        // Alıştırmalarda yapay zeka otomatik tamamlaması cevabı vermesin
        // (Yapay zeka bölümünde bu ayar birlikte açılacak)
        "editor.inlineSuggest.enabled": false,

        "editor.fontSize": 15,
        "terminal.integrated.fontSize": 14,
        "workbench.startupEditor": "readme"
      }
    }
  }
}
